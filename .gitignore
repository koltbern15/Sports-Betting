# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Caches
.ruff_cache/
.pytest_cache/

# Data — raw INPUTS are tracked for reproducibility (rebuild the DB + reports
# from these). Derived artifacts (the SQLite DB, processed CSVs) stay ignored.
data/processed/*
!data/processed/.gitkeep
data/db/*
!data/db/.gitkeep

# Brainstorm visual-companion working files
.superpowers/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Obsidian per-machine UI state (notes/plugin config can still be tracked)
.obsidian/workspace.json
.obsidian/workspace*.json

# uv (lockfile tracked for reproducible installs)

# Secrets
.env
.streamlit/secrets.toml

# Live odds cache (churny artifact written by fetch_odds; data/raw is otherwise tracked)
data/raw/odds_api_latest.json
# Derived board artifact (regenerate via scripts/build_board_artifact.py; embeds the cache above)
this_week_dashboard.html

# Design-QC screenshots (regenerable via `openwolf designqc`)
.wolf/designqc-captures/
# OpenWolf runtime logs (regenerated on every daemon launch)
.wolf/*.log

# Playwright MCP + ad-hoc screenshots (QC artifacts)
.playwright-mcp/
finding-tab*.jpeg
page-*.jpeg
