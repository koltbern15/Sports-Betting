# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Caches
.ruff_cache/
.pytest_cache/

# Data — raw INPUTS are tracked for reproducibility. Most derived artifacts stay
# ignored, BUT the prebuilt DB + the CSVs the deployed app reads are TRACKED so the
# Streamlit Cloud deploy ships with its data (historical data is static, 2004-2024).
data/processed/*
!data/processed/.gitkeep
!data/processed/ats_by_bucket.csv
!data/processed/totals_by_bucket.csv
!data/processed/edge_report.csv
data/db/*
!data/db/.gitkeep
!data/db/nfl_betting.sqlite

# Brainstorm visual-companion working files
.superpowers/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Obsidian per-machine UI state (notes/plugin config can still be tracked)
.obsidian/workspace.json
.obsidian/workspace*.json

# uv (lockfile tracked for reproducible installs)

# Secrets
.env
.streamlit/secrets.toml

# Live odds snapshot — TRACKED for the deploy (refreshed daily by the GitHub Action;
# public odds only, no secret). The app reads it; it never makes per-visitor pulls.
# Derived board artifact (regenerate via scripts/build_board_artifact.py; embeds the cache above)
this_week_dashboard.html

# Design-QC screenshots (regenerable via `openwolf designqc`)
.wolf/designqc-captures/
# OpenWolf runtime logs (regenerated on every daemon launch)
.wolf/*.log

# Playwright MCP + ad-hoc screenshots (QC artifacts)
.playwright-mcp/
finding-tab*.jpeg
page-*.jpeg
